    },
    {
      "label": "Roundtripzeit",
      "patterns": [
        "Roundtripzeit\\s*[:\\-]?\\s*(?P<val>[0-9][0-9\\., ]*\\s*(?:ms|s))"
      ]
    },
    {
      "label": "Gesendete Pakete",
      "patterns": [
        "Gesendete\\s*Pakete\\s*[:\\-]?\\s*(?P<val>[0-9][0-9\\.\\s]*)"
      ]
    },
    {
      "label": "Gesendeter Codec",
      "patterns": [
        "Gesendeter\\s*Codec\\s*[:\\-]?\\s*(?P<val>[A-Za-z0-9\\.\\-\\+_/ ]+)"
      ]
