{
  "fields": [
    {
      "label": "Gesendete Bitrate",
      "patterns": [
        "Gesendete\\s*Bitrate\\s*[:\\-]?\\s*(?P<val>[0-9][0-9\\., ]*\\s*(?:kbps|mbps|gbps|kbit/s|mbit/s|gbit/s|kbit\\s*/\\s*s|mbit\\s*/\\s*s|gbit\\s*/\\s*s|MBit/s|KBit/s|GBit/s|bit/s|bps))"
      ]
    },
    {
      "label": "Empfangene Bitrate",
      "patterns": [
        "Empfangene\\s*Bitrate\\s*[:\\-]?\\s*(?P<val>[0-9][0-9\\., ]*\\s*(?:kbps|mbps|gbps|kbit/s|mbit/s|gbit/s|kbit\\s*/\\s*s|mbit\\s*/\\s*s|gbit\\s*/\\s*s|MBit/s|KBit/s|GBit/s|bit/s|bps))"
      ]
    },
    {
      "label": "Gesendete Bildfrequenz",
      "patterns": [
        "Gesendete\\s*Bildfrequenz\\s*[:\\-]?\\s*(?P<val>[0-9][0-9\\., ]*\\s*(?:fps|Fps|Hz))"
      ]
    },
    {
      "label": "Gesendete Auflösung",
      "patterns": [
